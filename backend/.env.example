# Either supply a URL (percent-encode special characters in URL credentials)...
DATABASE_URL=
# ...or use these separate fields (compatible with the original local setup).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_servicedesk
DB_USER=campus_app
DB_PASSWORD=
# Generate a unique secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
